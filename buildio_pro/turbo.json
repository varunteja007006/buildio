{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DATABASE_NAME",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DB",
    "VALKEY_URL",
    "VALKEY_HOST",
    "VALKEY_PORT",
    "ALLOW_EMAIL_LOGIN",
    "SEND_EMAIL_VERIFICATION",
    "RESEND_API_KEY",
    "NEXT_PUBLIC_ENV",
    "NEXT_PUBLIC_CONVEX_URL",
    "CONVEX_DEPLOYMENT",
    "AI_GATEWAY_API_KEY",
    "AI_GATEWAY_TEAM_ID_OR_SLUG",
    "AI_EXTRACTION_MODEL",
    "AI_EMBEDDING_MODEL",
    "AI_EMBEDDING_DIMENSIONS",
    "CHAT_DEFAULT_MODEL",
    "CHAT_GUARDRAIL_ENABLED",
    "CHAT_GUARDRAIL_MODEL",
    "EXTRACTION_TEMPLATE_SUGGESTION_MODEL",
    "OPENAI_API_KEY",
    "VERCEL_OIDC_TOKEN",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "NEXT_PUBLIC_APP_URL",
    "TRUSTED_ORIGINS",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET",
    "S3_USE_SSL",
    "UPLOADTHING_TOKEN",
    "ENCRYPTION_KEY"
  ],
  "globalDependencies": [
    ".env"
  ]
}
