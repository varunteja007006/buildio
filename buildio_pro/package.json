{
  "name": "buildio_pro_monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "dev:web": "turbo dev --filter=web",
    "dev:expense-tracker": "turbo dev --filter=expense-tracker",
    "dev:poker-planner": "turbo dev --filter=poker-planner",
    "dev:housie-game": "turbo dev --filter=housie-game",
    "dev:scribble": "turbo dev --filter=scribble",
    "dev:cortex-ai": "turbo dev --filter=cortex-ai",
    "dev:billezy": "turbo dev --filter=billezy",
    "build:web": "turbo build --filter=web",
    "build:poker-planner": "turbo build --filter=poker-planner",
    "build:housie-game": "turbo build --filter=housie-game",
    "build:scribble": "turbo build --filter=scribble",
    "build:expense-tracker": "turbo build --filter=expense-tracker",
    "build:cortex-ai": "turbo build --filter=cortex-ai",
    "build:billezy": "turbo build --filter=billezy",
    "start:web": "pnpm --filter=web start",
    "start:poker-planner": "pnpm --filter=poker-planner start",
    "start:housie-game": "pnpm --filter=housie-game start",
    "start:scribble": "pnpm --filter=scribble start",
    "start:expense-tracker": "pnpm --filter=expense-tracker start",
    "start:cortex-ai": "pnpm --filter=cortex-ai start",
    "start:billezy": "pnpm --filter=billezy start",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "clean:all": "turbo run clean && git clean -xdf node_modules"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "3.9.10",
    "shadcn": "4.22.1",
    "turbo": "2.11.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=20"
  }
}
