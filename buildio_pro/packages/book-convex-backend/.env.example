# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

CONVEX_URL=

# Public HTTP actions URL of the deployment (ends in .convex.site)
CONVEX_SITE_URL=

# Base URL of the Next.js app consuming this backend (better-auth `baseURL`,
# read in convex/auth.ts). Set on the deployment via `npx convex env set
# SITE_URL=...` or add it here — `convex dev` syncs .env.local vars.
# Dev: http://localhost:3000
SITE_URL=
