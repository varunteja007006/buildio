# Template for eggsy env files — env files are gitignored, so copy this file
# before running ./build-apk.sh:
#   dev:  cp .env.example .env.local      (sourced by ./build-apk.sh dev)
#   prod: cp .env.example .env.production (sourced by ./build-apk.sh prod)

# Convex backend URL baked into the JS bundle — the only env var the app code reads.
# Dev builds point at the dev deployment; prod builds at the production deployment.
EXPO_PUBLIC_CONVEX_URL=https://your-prod-deployment.convex.cloud

# Production Convex deployment used by `npx convex deploy` (./build-apk.sh prod
# deploys the backend first so the APK ships with the latest functions/schema).
CONVEX_DEPLOYMENT=
