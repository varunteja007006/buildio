{
  "name": "cortex-ai",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "node ./scripts/clean-workspace.mjs",
    "clean:dry": "node ./scripts/clean-workspace.mjs --dry-run",
    "clean:cache": "node ./scripts/clean-workspace.mjs --mode cache",
    "clean:cache:dry": "node ./scripts/clean-workspace.mjs --mode cache --dry-run",
    "clean:deps": "node ./scripts/clean-workspace.mjs --mode deps",
    "clean:deps:dry": "node ./scripts/clean-workspace.mjs --mode deps --dry-run",
    "db:generate": "drizzle-kit generate",
    "db:export": "drizzle-kit export --config=drizzle.export.config.ts > lib/db/migrations/schema_export.sql",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
