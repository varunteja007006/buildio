# PostgreSQL
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Valkey (Redis-compatible cache)
VALKEY_URL=

# MinIO (S3-compatible object storage for documents and connector files)
# Local compose: endpoint http://localhost:9002, console http://localhost:9003
# Use an endpoint reachable from the browser because uploads use presigned URLs.
# MinIO console redirects use MINIO_BROWSER_REDIRECT_URL (defaults to localhost:9003).
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Connector dev servers (started by docker-compose; defaults below unless overridden)
# Postgres: postgresql://connector_test:connector_test@localhost:5434/connector_test
# Mongo:    mongodb://cortex_ai:cortex_ai@localhost:27017/cortex_ai?authSource=admin
# MySQL:    mysql://cortex_ai:cortex_ai@localhost:3306/cortex_ai
# SQLite:   no URL — upload a .sqlite/.db file (a seeded sample.db lives on the sqlite_data volume)
CONNECTOR_POSTGRES_USER=
CONNECTOR_POSTGRES_PASSWORD=
CONNECTOR_POSTGRES_DB=
MONGO_USER=
MONGO_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Vercel AI Gateway (required for embeddings & chat)
# Run `vercel link && vercel env pull` to generate OIDC token automatically
# VERCEL_OIDC_TOKEN=

# Or use an API key directly (create at Vercel Dashboard → AI Gateway → API Keys)
AI_GATEWAY_API_KEY=

# AI model configuration — REQUIRED, no hardcoded fallbacks
# Embedding model used for RAG ingestion + retrieval.
# AI_EMBEDDING_DIMENSIONS must match the embeddings.embedding vector column.
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=
# Default chat model used when a user/thread has no model preference.
CHAT_DEFAULT_MODEL=
# Default models for document extraction by input type.
DOCUMENT_EXTRACTION_MODEL=
PDF_EXTRACTION_MODEL=
IMAGE_EXTRACTION_MODEL=
# Allow users to select request- and template-level extraction models.
EXPOSE_USER_EXTRACTION_MODEL_CHOICE=false
# Model used to draft extraction templates from a sample document (required).
EXTRACTION_TEMPLATE_SUGGESTION_MODEL=

# Chat guardrail: scans user queries for harmful content and blocks risky ones.
# Enabled by default; set to "false" to disable. Model is REQUIRED while enabled.
CHAT_GUARDRAIL_ENABLED=true
CHAT_GUARDRAIL_MODEL=

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=
# Extra origins allowed for auth requests (full origin, comma-separated).
# e.g. http://192.168.1.10:3000,http://100.80.12.18:3000
TRUSTED_ORIGINS=

# Google OAuth (Better Auth)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts saved connector credentials at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
