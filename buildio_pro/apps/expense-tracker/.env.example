# env
NEXT_PUBLIC_ENV="dev"

# app URL (local dev: http://localhost:3018)
NEXT_PUBLIC_APP_URL=

# database - postgres
DATABASE_URL=

# authentication - better auth
BETTER_AUTH_SECRET=
# Local dev: http://localhost:3018
BETTER_AUTH_URL=

# enable email sign-up/login
ALLOW_EMAIL_LOGIN=
SEND_EMAIL_VERIFICATION=

# caching - valkey
VALKEY_URL=

# S3-compatible object storage for statements
# Local SeaweedFS: http://localhost:9000, bucket expense-tracker, keys minioadmin/minioadmin.
# Use an endpoint reachable from the browser because uploads use presigned URLs.
# Migration from MinIO: docs/knowledge-base/local-s3-storage-23-11-2026.md
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_USE_SSL=

# ai extraction - vercel ai gateway (key starts with `vck_` / `vcst_`)
AI_GATEWAY_API_KEY=
# optional: scope requests to a specific Vercel team
AI_GATEWAY_TEAM_ID_OR_SLUG=
# default model used for statement extraction — REQUIRED, no hardcoded fallback
# e.g. google/gemini-2.5-flash
AI_EXTRACTION_MODEL=

# auth providers
# Local Google OAuth redirect: http://localhost:3018/api/auth/callback/google
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=

# email service - resend
RESEND_API_KEY=
